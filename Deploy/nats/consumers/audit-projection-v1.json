{
  "durable_name": "audit-projection-v1",
  "name": "audit-projection-v1",
  "description": "首批平台事件审计投影；不得包含 Token 或私有手牌",
  "ack_policy": "explicit",
  "filter_subjects": [
    "identity.session.created.v1", "identity.session.revoked.v1",
    "room.created.v1", "room.state.changed.v1", "allocation.requested.v1",
    "gameserver.allocated.v1", "gameserver.ready.v1",
    "player.connected.v1", "player.disconnected.v1",
    "match.started.v1", "match.finished.v1",
    "settlement.committed.v1", "room.terminated.v1"
  ],
  "ack_wait": 30000000000,
  "max_deliver": 12,
  "backoff": [1000000000, 5000000000, 30000000000, 120000000000],
  "max_ack_pending": 1024
}

