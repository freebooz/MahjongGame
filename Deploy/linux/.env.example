MAHJONG_VERSION=dev
IMAGE_REGISTRY=local
GAME_SERVER_MAP=/Game/Maps/MahjongRoomMap?game=/Script/GuiyangMahjongServer.GuiyangMahjongGameMode
MAHJONG_DATA_ROOT=/var/lib/guiyang-mahjong
ADVERTISED_IP=192.0.2.10
AUTH_PORT=18082
LOBBY_PORT=18080
ALLOCATOR_PORT=18081
ADMIN_PORT=18083
PLAYER_DATA_PORT=18084
# GameData 仅绑定宿主机回环地址，供本机诊断；玩家客户端不得直接访问该端口。
GAMEDATA_PORT=18085
# Economy 仅绑定宿主机回环地址，避免形成新的玩家公网入口。
ECONOMY_PORT=18086
GAME_PORT_START=19000
GAME_PORT_END=19099
POSTGRES_CPUS=2.0
POSTGRES_MEMORY=2g
REDIS_CPUS=1.0
REDIS_MEMORY=1g
# 本地 JetStream 与 exporter 容量；生产 Kubernetes 使用三副本和独立 PVC。
NATS_CLIENT_PORT=14222
NATS_MONITOR_PORT=18222
NATS_EXPORTER_PORT=17777
NATS_CPUS=1.0
NATS_MEMORY=1g
NATS_EXPORTER_CPUS=0.25
NATS_EXPORTER_MEMORY=128m
WORKERS_CPUS=1.0
WORKERS_MEMORY=512m
AUTH_CPUS=1.0
AUTH_MEMORY=512m
LOBBY_CPUS=2.0
LOBBY_MEMORY=1g
GAME_NODE_CPUS=8.0
GAME_NODE_MEMORY=16g
ADMIN_CPUS=1.0
ADMIN_MEMORY=512m
PLAYER_DATA_CPUS=1.0
PLAYER_DATA_MEMORY=512m
# 结算事务与历史查询的容器容量默认值；生产按结算峰值压测结果调整。
GAMEDATA_CPUS=1.0
GAMEDATA_MEMORY=512m
MAHJONG_CLUSTER_ID=local-linux
MAHJONG_NODE_ID=game-node
POSTGRES_PASSWORD=replace-with-a-random-value
MIGRATION_DB_PASSWORD=replace-with-a-dedicated-migration-password
AUTH_DB_PASSWORD=replace-with-a-dedicated-auth-password
LOBBY_DB_PASSWORD=replace-with-a-dedicated-lobby-password
PLAYER_DATA_DB_PASSWORD=replace-with-a-dedicated-player-data-password
# GameData 运行身份密码，只授予五个自有 Schema 的 DML，不得具备 DDL。
GAME_DATA_DB_PASSWORD=replace-with-a-dedicated-game-data-password
# Economy 运行身份只拥有资产、奖励和 Outbox DML 权限。
ECONOMY_DB_PASSWORD=replace-with-a-dedicated-economy-password
# Configuration 运行身份只访问自有 Schema；签名、管理和读取凭据必须用途隔离。
CONFIGURATION_DB_PASSWORD=replace-with-a-dedicated-configuration-password
CONFIGURATION_SIGNING_KEY=replace-with-a-configuration-signing-key-at-least-32-characters
CONFIGURATION_ADMIN_TOKEN=replace-with-a-configuration-admin-token-at-least-32-characters
CONFIGURATION_READ_TOKEN=replace-with-a-configuration-read-token-at-least-32-characters
CONFIGURATION_CPUS=0.5
CONFIGURATION_MEMORY=256m
# Worker 账号只能领取、标记和归档各服务 Outbox，并写入自有 Inbox/投影。
WORKERS_DB_PASSWORD=replace-with-a-dedicated-workers-password
ADMIN_DB_PASSWORD=replace-with-a-dedicated-admin-password
MONITOR_DB_PASSWORD=replace-with-a-dedicated-monitor-password
AUDIT_DB_PASSWORD=replace-with-a-dedicated-audit-append-password
ARCHIVE_DB_PASSWORD=replace-with-a-dedicated-archive-password
# 示例值必须部署前替换；不得把真实 NATS 凭据提交到仓库。
NATS_USERNAME=mahjong-workers-local
NATS_PASSWORD=replace-with-a-dedicated-nats-password
PLAYER_TOKEN_SIGNING_KEY=replace-with-at-least-32-random-characters
GUEST_IDENTITY_PEPPER=replace-with-at-least-32-random-characters
JOIN_TICKET_SIGNING_KEY=replace-with-at-least-32-random-characters
# 最终结算 HMAC 密钥与 Join Ticket 密钥分离，并同时注入 DS、Allocator 和 GameData。
SETTLEMENT_SIGNING_KEY=replace-with-a-distinct-settlement-signing-key-at-least-32-characters
# Allocator 崩溃恢复入口的用途隔离令牌，不得用于正常 DS 提交。
GAMEDATA_RECOVERY_TOKEN=replace-with-a-dedicated-gamedata-recovery-token-at-least-32-characters
# 阶段8.2旧回放索引迁入凭据，仅授权GameData兼容写入口。
GAMEDATA_LEGACY_REPLAY_TOKEN=replace-with-a-dedicated-gamedata-replay-token-at-least-32-characters
# Economy 三类调用方凭据严格隔离，不得与 PlayerData 旧凭据复用。
ECONOMY_SOURCE_TOKEN=replace-with-a-dedicated-economy-source-token-at-least-32-characters
ECONOMY_ADMIN_TOKEN=replace-with-a-dedicated-economy-admin-token-at-least-32-characters
ECONOMY_MONITORING_TOKEN=replace-with-a-dedicated-economy-monitor-token-at-least-32-characters
# GameData 与 Lobby 之间的权威核对/提交完成回调令牌。
GAMEDATA_LOBBY_AUTHORITY_TOKEN=replace-with-a-dedicated-gamedata-lobby-token-at-least-32-characters
# GameRecords、ReplayEvidence 和排行榜内部只读查询令牌。
GAMEDATA_MONITORING_TOKEN=replace-with-a-dedicated-gamedata-monitor-token-at-least-32-characters
# Legacy 可快速回滚旧结算入口；GameData 为正式切流模式，Shadow 仅用于部署演练。
LOBBY_SETTLEMENT_MODE=GameData
LOBBY_INTERNAL_TOKEN=replace-with-at-least-32-random-characters
ALLOCATOR_SERVICE_TOKEN=replace-with-at-least-32-random-characters
MONITORING_READ_ONLY_TOKEN=replace-with-a-different-32-character-random-value
AUTH_MANAGEMENT_COMMAND_TOKEN=replace-with-a-dedicated-32-character-random-value
LOBBY_MANAGEMENT_COMMAND_TOKEN=replace-with-another-dedicated-32-character-random-value
ALLOCATOR_MANAGEMENT_COMMAND_TOKEN=replace-with-a-third-dedicated-32-character-random-value
LOBBY_ACCESS_REVOCATION_TTL_MINUTES=120
ADMIN_READ_ONLY_TOKEN=replace-with-a-different-32-character-random-value
ADMIN_EVIDENCE_INGESTION_TOKEN=replace-with-a-dedicated-32-character-random-value
ADMIN_CHAT_ARCHIVE_ENABLED=false
ADMIN_CHAT_ARCHIVE_BASE_URL=https://chat-archive.example.com
ADMIN_CHAT_ARCHIVE_QUERY_TOKEN=replace-with-a-chat-read-only-32-character-random-value
ADMIN_CHAT_ARCHIVE_TIMEOUT_SECONDS=5
ADMIN_CHAT_ARCHIVE_MAX_ENTRIES=100
ADMIN_REPLAY_ARCHIVE_ENABLED=false
ADMIN_REPLAY_ARCHIVE_BASE_URL=https://replay-archive.example.com
ADMIN_REPLAY_ARCHIVE_READ_TOKEN=replace-with-a-replay-read-only-32-character-random-value
ADMIN_REPLAY_ARCHIVE_SIGNING_KEY=replace-with-a-distinct-signing-key-at-least-32-characters
ADMIN_REPLAY_ACCESS_TTL_SECONDS=300
ADMIN_REPLAY_MAX_OBJECT_MEGABYTES=64
ADMIN_ENTERPRISE_IDENTITY_ENABLED=true
ADMIN_OIDC_AUTHORITY=https://identity.example.com/tenant
ADMIN_OIDC_AUDIENCE=mahjong-admin
ADMIN_ABAC_ENABLED=true
ADMIN_ABAC_REGION_CLAIM=mahjong_regions
ADMIN_ABAC_SHIFT_CLAIM=mahjong_shift
ADMIN_ABAC_CASE_CLAIM=mahjong_cases
ADMIN_ABAC_BREAK_GLASS_UNTIL_CLAIM=mahjong_break_glass_until
ADMIN_HIGH_VALUE_COMPENSATION_THRESHOLD=100000
ADMIN_TOPOLOGY_DISCOVERY_ENABLED=true
ADMIN_TOPOLOGY_REGISTRATION_TOKEN=replace-with-a-dedicated-topology-registration-32-character-random-value
ADMIN_TOPOLOGY_LOBBY_TOKEN=replace-with-a-dedicated-topology-lobby-read-32-character-random-value
ADMIN_TOPOLOGY_ALLOCATOR_TOKEN=replace-with-a-dedicated-topology-allocator-read-32-character-random-value
ADMIN_TOPOLOGY_LEASE_SECONDS=60
MAHJONG_REGION_ID=local
MAHJONG_CLUSTER_ID=local-linux
MAHJONG_LOBBY_ID=lobby-local-1
MAHJONG_LOBBY_NODE_ID=lobby-node-1
MAHJONG_ALLOCATOR_ID=allocator-local-1
MAHJONG_NODE_ID=game-node
MAHJONG_DEPLOYMENT_GENERATION=1
ADMIN_AUDIT_ARCHIVE_ENABLED=false
ADMIN_AUDIT_ARCHIVE_APPEND_URL=https://worm-archive.example.com/v1/admin-audit
ADMIN_AUDIT_ARCHIVE_APPEND_TOKEN=replace-with-a-dedicated-worm-archive-32-character-random-value
ADMIN_AUDIT_ARCHIVE_POLL_MS=1000
ADMIN_AUDIT_ARCHIVE_MAX_ATTEMPTS=20
ADMIN_AUDIT_ANCHOR_ENABLED=false
ADMIN_AUDIT_ANCHOR_URL=https://worm-archive.example.com/v1/admin-audit-anchor
ADMIN_AUDIT_ANCHOR_INTERVAL_SECONDS=300
PLAYER_DATA_SOURCE_INGESTION_TOKEN=replace-with-a-dedicated-source-32-character-random-value
PLAYER_DATA_ADMIN_COMMAND_TOKEN=replace-with-a-dedicated-wallet-32-character-random-value
PLAYER_DATA_CHAT_GATEWAY_TOKEN=replace-with-a-dedicated-chat-32-character-random-value
PLAYER_DATA_MONITORING_TOKEN=replace-with-a-dedicated-player-data-monitor-32-character-random-value
PLAYER_DATA_PROJECTION_POLL_MS=1000
PLAYER_DATA_PROJECTION_MAX_ATTEMPTS=10
ADMIN_MANAGEMENT_ENABLED=false
ADMIN_PLAYER_PAGES_PER_SNAPSHOT_CYCLE=20
ADMIN_COMMAND_EXECUTION_ENABLED=false
ADMIN_COMMAND_POLL_INTERVAL_MS=1000
ADMIN_COMMAND_LEASE_SECONDS=30
ADMIN_COMMAND_MAX_ATTEMPTS=5
ADMIN_COMMAND_RETRY_BASE_SECONDS=5
ADMIN_COMMAND_TIMEOUT_SECONDS=5
ADMIN_WALLET_TIMEOUT_SECONDS=5
ADMIN_TEMPORARY_FREEZE_HOURS=24
ADMIN_MUTE_HOURS=24
ADMIN_RISK_LABEL_TTL_DAYS=30
ADMIN_ROOM_OPERATOR_ID=room-operator
ADMIN_ROOM_OPERATOR_TOKEN=replace-with-a-third-32-character-random-value
ADMIN_ROOM_APPROVER_ID=room-approver
ADMIN_ROOM_APPROVER_TOKEN=replace-with-a-fourth-32-character-random-value
ADMIN_PLAYER_OPERATOR_ID=player-operator
ADMIN_PLAYER_OPERATOR_TOKEN=replace-with-a-fifth-32-character-random-value
ADMIN_PLAYER_APPROVER_ID=player-approver
ADMIN_PLAYER_APPROVER_TOKEN=replace-with-a-sixth-32-character-random-value
ADMIN_INFRASTRUCTURE_OPERATOR_ID=infrastructure-operator
ADMIN_INFRASTRUCTURE_OPERATOR_TOKEN=replace-with-a-seventh-32-character-random-value
ADMIN_SANCTION_OPERATOR_ID=sanction-operator
ADMIN_SANCTION_OPERATOR_TOKEN=replace-with-an-eighth-32-character-random-value
ADMIN_RISK_ANALYST_ID=risk-analyst
ADMIN_RISK_ANALYST_TOKEN=replace-with-a-ninth-32-character-random-value
ADMIN_SUPPORT_OPERATOR_ID=support-operator
ADMIN_SUPPORT_OPERATOR_TOKEN=replace-with-a-tenth-32-character-random-value
ADMIN_COMPENSATION_OPERATOR_ID=compensation-operator
ADMIN_COMPENSATION_OPERATOR_TOKEN=replace-with-an-eleventh-32-character-random-value
ADMIN_CHAT_COMPLIANCE_ID=chat-compliance
ADMIN_CHAT_COMPLIANCE_TOKEN=replace-with-a-twelfth-32-character-random-value
# Linux 生产部署变量模板：复制为权限 0600 的未跟踪 .env，并替换全部密钥、地址和版本占位符。
# 端口、超时和资源值需与 Compose、监控和防火墙一致；变量值不得包含未经转义的换行。
# deploy.sh 会校验关键变量，真实凭据不得提交、打印或进入诊断归档。
