server {
    listen 8080;
    server_tokens off;

    location /loki/api/v1/query {
        if ($http_authorization != "Bearer ${LOKI_QUERY_TOKEN}") { return 401; }
        proxy_pass http://loki:3100;
        proxy_set_header Host $host;
    }

    location /loki/api/v1/query_range {
        if ($http_authorization != "Bearer ${LOKI_QUERY_TOKEN}") { return 401; }
        proxy_pass http://loki:3100;
        proxy_set_header Host $host;
    }

    location / {
        return 404;
    }
}
