<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- 消息构件提供中立契约和官方 NATS JetStream 适配器；业务项目仍只依赖 IEventPublisher。 -->
    <Description>事件发布、JetStream 适配及 Outbox/Inbox 模型与接口。</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- NATS 客户端只集中在消息基础构件，避免每个业务服务各自实现传输细节。 -->
    <PackageReference Include="NATS.Net" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Contracts\GuiyangMahjong.Contracts.Common\GuiyangMahjong.Contracts.Common.csproj" />
    <ProjectReference Include="..\..\Contracts\GuiyangMahjong.Contracts.Events\GuiyangMahjong.Contracts.Events.csproj" />
  </ItemGroup>
</Project>
