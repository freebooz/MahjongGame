<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Angular 源码目录只参与前端构建，不作为 ASP.NET 静态内容直接发布。 -->
    <AdminClientRoot>$(MSBuildProjectDirectory)\ClientApp</AdminClientRoot>
    <!-- Schema 输出规则由 Services/Directory.Build.targets 统一生成和校验。 -->
    <MahjongSchemaServiceName>Admin</MahjongSchemaServiceName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GuiyangMahjong.Observability\GuiyangMahjong.Observability.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildAngularAdminClient"
          BeforeTargets="Publish"
          Condition="'$(SkipAdminClientBuild)' != 'true'">
    <!-- 发布前从锁文件执行可复现安装并生成 Angular 22 生产包，禁止手工维护 wwwroot。 -->
    <Exec WorkingDirectory="$(AdminClientRoot)"
          Command="npm ci --no-audit --no-fund" />
    <Exec WorkingDirectory="$(AdminClientRoot)"
          Command="npm run typecheck" />
    <Exec WorkingDirectory="$(AdminClientRoot)"
          Command="npm run build" />
  </Target>
</Project>
