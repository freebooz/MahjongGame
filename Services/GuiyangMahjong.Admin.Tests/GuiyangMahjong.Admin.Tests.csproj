<Project Sdk="Microsoft.NET.Sdk">
  <!-- Admin API、RBAC、审批、审计、监控聚合与证据闭环测试项目。测试依赖只用于验证，不得被生产项目反向引用。 -->
  <!-- 外部 PostgreSQL/Redis 测试由显式环境变量启用；默认测试必须保持可重复且不访问开发者本机服务。 -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GuiyangMahjong.Admin\GuiyangMahjong.Admin.csproj" />
    <ProjectReference Include="..\GuiyangMahjong.Observability\GuiyangMahjong.Observability.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\Contracts\OpenAPI\lobby-v1.openapi.yaml"
             Link="Contracts\lobby-v1.openapi.yaml"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\Contracts\Monitoring\runtime-telemetry-v1.schema.json"
             Link="Contracts\runtime-telemetry-v1.schema.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
