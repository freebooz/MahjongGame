<Solution>
  <!-- .NET 服务统一解决方案入口：同时包含生产服务、共享可观测性和全部测试项目。 -->
  <!-- 新服务必须在此登记并遵守 Directory.Build.* 与 Directory.Packages.props；不得通过解决方案引用共享数据库内部实现。 -->
  <Project Path="GuiyangMahjong.Architecture.Tests/GuiyangMahjong.Architecture.Tests.csproj" />
  <Project Path="GuiyangMahjong.Admin.Tests/GuiyangMahjong.Admin.Tests.csproj" />
  <Project Path="GuiyangMahjong.Allocator.Tests/GuiyangMahjong.Allocator.Tests.csproj" />
  <Project Path="GuiyangMahjong.Allocator/GuiyangMahjong.Allocator.csproj" />
  <Project Path="GuiyangMahjong.Admin/GuiyangMahjong.Admin.csproj" />
  <Project Path="GuiyangMahjong.Auth.Tests/GuiyangMahjong.Auth.Tests.csproj" />
  <Project Path="GuiyangMahjong.Auth/GuiyangMahjong.Auth.csproj" />
  <Project Path="GuiyangMahjong.Lobby.Tests/GuiyangMahjong.Lobby.Tests.csproj" />
  <Project Path="GuiyangMahjong.Lobby/GuiyangMahjong.Lobby.csproj" />
  <Project Path="GuiyangMahjong.Observability/GuiyangMahjong.Observability.csproj" />
  <Project Path="Apps/GuiyangMahjong.EdgeGateway/GuiyangMahjong.EdgeGateway.csproj" />
  <Project Path="Apps/GuiyangMahjong.EdgeGateway.Tests/GuiyangMahjong.EdgeGateway.Tests.csproj" />
  <!-- 阶段 7：最终结算、战绩、回放证据和基础排行榜的独立部署单元及测试。 -->
  <Project Path="Apps/GuiyangMahjong.GameData/GuiyangMahjong.GameData.csproj" />
  <Project Path="Apps/GuiyangMahjong.GameData.Tests/GuiyangMahjong.GameData.Tests.csproj" />
  <!-- 阶段 8.3：奖励、资产余额与不可变交易流水的唯一写入者。 -->
  <Project Path="Apps/GuiyangMahjong.Economy/GuiyangMahjong.Economy.csproj" />
  <Project Path="Apps/GuiyangMahjong.Economy.Tests/GuiyangMahjong.Economy.Tests.csproj" />
  <!-- 阶段 8.4：聊天发送授权边界及兼容测试。 -->
  <Project Path="Apps/GuiyangMahjong.Community/GuiyangMahjong.Community.csproj" />
  <Project Path="Apps/GuiyangMahjong.Community.Tests/GuiyangMahjong.Community.Tests.csproj" />
  <!-- 阶段 11：不可变动态配置、灰度求值、签名发布与回滚的独立数据所有者。 -->
  <Project Path="Apps/GuiyangMahjong.Configuration/GuiyangMahjong.Configuration.csproj" />
  <Project Path="Apps/GuiyangMahjong.Configuration.Tests/GuiyangMahjong.Configuration.Tests.csproj" />
  <!-- 阶段 9：可靠事件发布、幂等投影、维护与消息积压监控部署单元。 -->
  <Project Path="Apps/GuiyangMahjong.Workers/GuiyangMahjong.Workers.csproj" />
  <Project Path="Apps/GuiyangMahjong.Workers.Tests/GuiyangMahjong.Workers.Tests.csproj" />
  <!-- 阶段 2 共享契约：只能描述跨边界数据，禁止引用业务服务和持久化实现。 -->
  <Project Path="Contracts/GuiyangMahjong.Contracts.Common/GuiyangMahjong.Contracts.Common.csproj" />
  <Project Path="Contracts/GuiyangMahjong.Contracts.Api/GuiyangMahjong.Contracts.Api.csproj" />
  <Project Path="Contracts/GuiyangMahjong.Contracts.Grpc/GuiyangMahjong.Contracts.Grpc.csproj" />
  <Project Path="Contracts/GuiyangMahjong.Contracts.Events/GuiyangMahjong.Contracts.Events.csproj" />
  <!-- 阶段 2 基础构件：按 Domain → 专用构件 → Persistence 的方向组织。 -->
  <Project Path="BuildingBlocks/GuiyangMahjong.BuildingBlocks.Domain/GuiyangMahjong.BuildingBlocks.Domain.csproj" />
  <Project Path="BuildingBlocks/GuiyangMahjong.BuildingBlocks.Persistence/GuiyangMahjong.BuildingBlocks.Persistence.csproj" />
  <Project Path="BuildingBlocks/GuiyangMahjong.BuildingBlocks.Messaging/GuiyangMahjong.BuildingBlocks.Messaging.csproj" />
  <Project Path="BuildingBlocks/GuiyangMahjong.BuildingBlocks.Idempotency/GuiyangMahjong.BuildingBlocks.Idempotency.csproj" />
  <Project Path="BuildingBlocks/GuiyangMahjong.BuildingBlocks.Security/GuiyangMahjong.BuildingBlocks.Security.csproj" />
  <Project Path="BuildingBlocks/GuiyangMahjong.BuildingBlocks.Observability/GuiyangMahjong.BuildingBlocks.Observability.csproj" />
  <Project Path="BuildingBlocks/GuiyangMahjong.BuildingBlocks.Tests/GuiyangMahjong.BuildingBlocks.Tests.csproj" />
</Solution>
