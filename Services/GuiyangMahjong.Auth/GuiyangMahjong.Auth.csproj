<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <InvariantGlobalization>false</InvariantGlobalization>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Schema 输出规则由 Services/Directory.Build.targets 统一生成和校验。 -->
    <MahjongSchemaServiceName>Auth</MahjongSchemaServiceName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GuiyangMahjong.Observability\GuiyangMahjong.Observability.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\Contracts\OpenAPI\auth-v1.openapi.yaml"
             Link="OpenAPI\auth-v1.openapi.yaml"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
