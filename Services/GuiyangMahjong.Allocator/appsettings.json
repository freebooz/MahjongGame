{
  "Allocator": {
    "_说明": "Backend 必须显式选择 LocalProcess 或 Agones；活动房间运行中不得切换 Provider，状态文件只保存可核对的运行租约。",
    "Backend": "LocalProcess",
    "PortStart": 19000,
    "PortEnd": 19099,
    "ValidateOperatingSystemPortAvailability": true,
    "RegistrationTimeoutSeconds": 30,
    "StartupTimeoutSeconds": 30,
    "HeartbeatTimeoutSeconds": 15,
    "HeartbeatIntervalSeconds": 3,
    "MonitorIntervalMilliseconds": 500,
    "DrainGraceSeconds": 3,
    "AllowLegacyInitialFencingToken": true,
    "AdvertisedIp": "127.0.0.1",
    "GameServerExecutablePath": "",
    "GameServerWorkingDirectory": "",
    "GameServerPrefixArguments": [],
    "MatchResultOutboxDirectory": "match-result-outbox",
    "RecoveryDirectory说明": "Dedicated Server 动作证据与完整快照根目录；生产必须放在持久卷，Agones 由 Fleet RWX PVC 覆盖。",
    "RecoveryDirectory": "game-recovery",
    "StateFilePath": "allocator-state/instances.json",
    "StateCheckpointSeconds": 5,
    "FailureNotificationRetrySeconds": 5,
    "MatchResultRecoveryDelaySeconds": 15,
    "LobbyInternalUrl": "http://127.0.0.1:18080",
    "GameDataInternalUrl说明": "Dedicated Server 最终结算内网地址；不得配置为玩家 EdgeGateway。",
    "GameDataInternalUrl": "http://127.0.0.1:18085",
    "SettlementSigningKey说明": "结算 HMAC 密钥必须由环境变量 Allocator__SettlementSigningKey 注入，禁止提交真实值。",
    "SettlementSigningKey": "",
    "GameDataRecoveryToken说明": "Outbox 恢复专用令牌必须由环境变量 Allocator__GameDataRecoveryToken 注入。",
    "GameDataRecoveryToken": "",
    "ServiceToken": "",
    "MonitoringReadOnlyToken": "",
    "ManagementCommandToken": "",
    "LobbyCallbackToken": "",
    "JoinTicketSigningKey": "",
    "RegionId": "local",
    "ClusterId": "local",
    "NodeId": "game-node",
    "AllocatorId": "allocator-local-1",
    "TopologyRegistration": {
      "Enabled": false,
      "AdminBaseUrl": "http://127.0.0.1:18083",
      "PublicBaseUrl": "http://127.0.0.1:18081",
      "RegistrationToken": "",
      "SourceId": "allocator-local-1",
      "Generation": 1,
      "RefreshSeconds": 20
    },
    "Agones": {
      "_说明": "Agones 身份来自 Pod ServiceAccount 挂载；不得把 Token、CA 或注册凭据写入配置文件和日志。",
      "Namespace": "guiyang-mahjong",
      "FleetName": "guiyang-mahjong",
      "ApiServer": "https://kubernetes.default.svc",
      "ServiceAccountTokenPath": "/var/run/secrets/kubernetes.io/serviceaccount/token",
      "ServiceAccountCaPath": "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt",
      "RequestTimeoutSeconds": 10,
      "DynamicFleetConfiguration": {
        "_说明": "默认关闭并使用 FleetName 安全基线；生产由环境变量启用，读取令牌与签名密钥必须来自 Secret，LKG 路径必须位于持久卷。",
        "Enabled": false,
        "BaseUrl": "http://configuration:18086",
        "PollSeconds": 30,
        "LastKnownGoodPath": "allocator-state/fleet-routing-lkg.json",
        "ReadToken": "",
        "SigningKey": ""
      }
    }
  },
  "Observability": {
    "Enabled": false,
    "OtlpEndpoint": "http://127.0.0.1:4317",
    "TraceSampleRatio": 0.1,
    "RuntimeMetricsEnabled": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
