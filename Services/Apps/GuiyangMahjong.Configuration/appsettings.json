{
  "ConfigurationService": {
    "PersistenceMode": "InMemory",
    "PostgresConnectionString": "",
    "ApplyDatabaseMigrations": false,
    "SigningKey": "local-configuration-signing-key-change-me",
    "AdminCommandToken": "local-configuration-admin-token-change-me",
    "ServiceReadToken": "local-configuration-reader-token-change-me",
    "RetainedVersions": 10
  },
  "Observability": {
    "Enabled": false,
    "OtlpEndpoint": "http://otel-collector:4317",
    "TraceSampleRatio": 1.0,
    "RuntimeMetricsEnabled": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
